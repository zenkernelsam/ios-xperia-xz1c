+/* v725 bounded diagnostics: no extra allocation, pin, map, or release operations. */
+static void sweet_caller_diag(const char *phase, uint64_t address, uint64_t bytes, uint32_t status)
+{
+    static volatile SInt32 successes, failures;
+    SInt32 count = OSIncrementAtomic(status ? &failures : &successes) + 1;
+    if (count > (status ? 24 : 8)) return;
+    IOLog("SWEET SURF CALLER DIAG phase=%s pid=%d address=%#llx bytes=%llu status=%#x count=%d\n",
+        phase, proc_selfpid(), (unsigned long long)address, (unsigned long long)bytes, status, count);
+}
 static void *sweet_caller_allocate(void *task, uint64_t start, uint64_t bytes)
 {
     IOMemoryDescriptor *descriptor = IOMemoryDescriptor::withAddressRange(start, bytes,
         kIODirectionInOut | kIOMemoryMapperNone | kIOMemoryThreadSafe | kIOMemoryPersistent,
         (task_t)task);
+    sweet_caller_diag("allocate", start, bytes, descriptor ? 0 : kIOReturnNoMemory);
     return descriptor;
 }
 static int sweet_caller_prepare(void *, void *descriptor)
-{ return (int)((IOMemoryDescriptor *)descriptor)->prepare(kIODirectionInOut); }
+{
+    auto *memory = (IOMemoryDescriptor *)descriptor;
+    IOReturn result = memory->prepare(kIODirectionInOut);
+    sweet_caller_diag("prepare", 0, memory->getLength(), result);
+    return (int)result;
+}
 static int sweet_caller_complete(void *, void *descriptor)
 { return (int)((IOMemoryDescriptor *)descriptor)->complete(kIODirectionInOut); }
 static void sweet_caller_release(void *, void *descriptor)
