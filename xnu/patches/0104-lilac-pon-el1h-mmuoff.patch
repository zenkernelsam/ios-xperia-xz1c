diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index f001122..b08cc02 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -279,9 +279,16 @@ LEXT(LowExceptionVectorBase)
 #if defined(SWEET)
 	/* EL1h synchronous vector (offset 0x200). PON:
 	 *   0x88e <- 0xc0|EC (ESR_EL1[31:26] exception class)
 	 *   0x88d <- FAR_EL1[27:20] (fault-address megabyte)
-	 * Channel goes through the V=P map when MMU is on; PA otherwise. */
-	MOV64	x12, 0x8420000
+	 *   0x88c <- ELR_EL1[27:20] (return-address megabyte)
+	 * Drop the MMU first so the writes go to PA regardless of how
+	 * broken the bootstrap maps are. */
+	mrs		x13, SCTLR_EL1
+	mov		x14, #(SCTLR_M_ENABLED | SCTLR_C_ENABLED | SCTLR_I_ENABLED)
+	bic		x13, x13, x14
+	msr		SCTLR_EL1, x13
+	isb		sy
+	MOV64	x12, 0x8420000
 	mrs		x13, ESR_EL1
 	ubfx	x13, x13, #26, #6
 	orr		x13, x13, #0xc0
@@ -288,12 +295,17 @@ LEXT(LowExceptionVectorBase)
 	mov		w13, #0x8e0
 	str		w13, [x12]
 	mrs		x13, FAR_EL1
 	ubfx	x13, x13, #20, #8
 	str		w13, [x12, #0x10]
 	mov		w13, #0x8d0
 	str		w13, [x12]
+	mrs		x13, ELR_EL1
+	ubfx	x13, x13, #20, #8
+	str		w13, [x12, #0x10]
+	mov		w13, #0x8c0
+	str		w13, [x12]
 	dsb		sy
 #endif
 	b		.
 	.align	7
 	b		.
