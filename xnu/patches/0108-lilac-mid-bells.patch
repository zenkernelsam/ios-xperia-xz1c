+2:
 #endif
 
 	// Set the translation control register.
@@ -968,6 +975,16 @@ LEXT(start_first_cpu)
 1:
 	MSR_VBAR_EL1_X0
 
+#if defined(SWEET)
+	/* 0xa7: VBAR (KVA) written -- nothing but the PAC skip and the
+	 * 0xa4 bell stands between here and the SCTLR write. */
+	MOV64	x12, 0x8420000
+	mov		w13, #0xa7
+	str		w13, [x12, #0x10]
+	mov		w13, #0x8e0
+	str		w13, [x12]
