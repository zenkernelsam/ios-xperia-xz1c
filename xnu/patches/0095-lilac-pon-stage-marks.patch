diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index a33f045..175bcc5 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1860,6 +1860,13 @@ sweet_early_map_final(void)
 	slot[2] = 0xfe000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	/* SPMI arbiter v2 write channel space: apid-4 (PM8998 PON) regs
+	 * at 0x8400000 + 0x8000*4 = 0x8420000. The PON spare byte 0x88e
+	 * survives warm AND crash resets -- the only durable mark channel
+	 * (IMEM is rewritten by TZ, DDR is wiped). Block = 0x8000000. */
+	assert(slot[3] == ARM_TTE_EMPTY);
+	slot[3] = 0x8000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index a8e4eec..807b191 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -683,6 +683,16 @@ Lkernelcache_base_found:
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	/* Fourth slot: the 32MB block at 0x08000000 covers the SPMI
+	 * pmic-arbiter write channels (apid4 PON regs @ 0x8420000) as
+	 * Device -- lets every pre-relocate stage mark reach the
+	 * durable PMIC spare byte too. */
+	MOV64	x10, 0x08000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 88396e6..1e87dac 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -96,6 +96,27 @@ static unsigned int early_mark_seq;
 
 #define PERSISTENT_RAM_SIG 0x43474244u
 
+/* PM8998 PON spare byte 0x88e through the SPMI pmic-arbiter v2 write
+ * channel (CAF spmi-pmic-arb.c): apid 4 => 0x8400000 + 0x8000*4.
+ * Per-channel regs: CMD=0x00 STATUS=0x08 WDATA0=0x10; PON 0x8xx uses
+ * EXT_WRITE (opc 0, addr<11:4). Survives warm + crash resets; Android
+ * reads it via /sys/kernel/debug/regmap/spmi0-00. PON byte encoding:
+ *   0x00-0x7f = stage marks (low byte of 0x77664Dxx / 0x7766D0xx),
+ *   0x80-0x9f = panic mark (0x80 | last_stage), distinct from stage. */
+static volatile uint32_t *early_pon =
+	(volatile uint32_t *)(uintptr_t)0x8420000;
+static void
+early_pon_write(uint32_t v)
+{
+	early_pon[4] = v & 0xff;                       /* CH_WDATA0 */
+	early_pon[0] = (0u << 27) | (0x8eu << 4);      /* CH_CMD EXT_WRITE */
+	for (int i = 0; i < 100000; i++)
+		if (early_pon[2] & 1u)                     /* CH_STATUS DONE */
+			return;
+}
+
 static void
 early_stage_write(unsigned int v)
 {
+	early_pon_write(v);
 	*EARLY_RR = v;
 	*EARLY_DURABLE = v;
 	early_durable[1] = ++early_mark_seq;
@@ -165,6 +186,11 @@ sweet_early_panic(const char *fmt, va_list *args)
 	early_panicking = 1;
 	early_stage_write(0x77665000u | (early_last_stage & 0xff));
 	__asm__ volatile("dsb sy" ::: "memory");
+	/* Panic gets a distinct PON byte (0x80|stage) so a postmortem
+	 * read can tell "died mid-stage-N" from "panicked at stage-N". */
+	early_pon_write(0x80u | (early_last_stage & 0x3f));
+	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_string("\nSWEET EARLY PANIC: ");
 	va_list copy;
 	va_copy(copy, *args);
@@ -181,6 +207,8 @@ sweet_early_relocate(uint64_t base)
 	early_imem = (volatile uint32_t *)(uintptr_t)(base + ARM_TT_L2_SIZE + 0x6bf000);
 	early_durable = (volatile uint32_t *)(uintptr_t)(base + 2 * ARM_TT_L2_SIZE + 0x1bff000);
 	early_prz = (volatile uint32_t *)(uintptr_t)(base + 2 * ARM_TT_L2_SIZE + 0x1c07000);
+	/* slot[3] = phys 0x8000000; SPMI apid-4 write ch at +0x420000 */
+	early_pon = (volatile uint32_t *)(uintptr_t)(base + 3 * ARM_TT_L2_SIZE + 0x420000);
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
