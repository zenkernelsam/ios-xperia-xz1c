# Everything that a POSIX toolchain reads must keep LF endings —
# CI runs on macOS where `set -euo pipefail\r` and CRLF patch context fail.
*.sh    text eol=lf
*.patch text eol=lf
# Unified-diff context prefixes unchanged tabs and blank lines with one space.
*.patch whitespace=-space-before-tab,-blank-at-eol
xnu/patches/** text eol=lf
*.diff  text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.S     text eol=lf
*.ld    text eol=lf
*.mm    text eol=lf
*.ll    text eol=lf
*.md    text eol=lf
*.m     text eol=lf
*.inc   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.swift text eol=lf
*.ps1   text eol=lf
gpu/metal/xr/reference/** -text
gpu/metal/air/half/reference/** -text
# Historical originals are fingerprinted as bytes, including their line ends.
# Keep them exactly as archived rather than applying current source formatting.
docs/archive/20261120/attachment-hardware-r1/** -text -eol whitespace=cr-at-eol
docs/archive/20261121/weekly-integration/** -text -eol whitespace=cr-at-eol
docs/archive/20261122/native-r15-close-out/originals/** -text -eol whitespace=cr-at-eol
# Every new originals directory has the same immutable-byte contract.
docs/archive/**/originals/** -text -eol whitespace=cr-at-eol
docs/archive/20261124/cache-budget-close-out/** -text -eol whitespace=cr-at-eol
docs/archive/20261124/cache-budget-close-out/original-document-manifest.json text eol=lf
# Original evidence reports retain the bytes saved by their verifier.
reproducibility/cache-budget-peripheral-host-validation-20261125.json -text -eol whitespace=cr-at-eol
reproducibility/cache-export-paced-r25-gpu-actual-20261123.json -text -eol whitespace=cr-at-eol
reproducibility/poster-cache-budget-gles9-actual-20261124.json -text -eol whitespace=cr-at-eol
reproducibility/v732-aegir-earth-link-symbols-20261127.json -text -eol whitespace=cr-at-eol
# Archive manifests are current metadata, not copies of historical sources.
docs/archive/20261120/attachment-hardware-r1/original-documents.json text eol=lf
docs/archive/20261121/weekly-integration/original-document-manifest.json text eol=lf
.gitattributes text eol=lf
