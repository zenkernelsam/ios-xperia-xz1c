# Everything that a POSIX toolchain reads must keep LF endings —
# CI runs on macOS where `set -euo pipefail\r` and CRLF patch context fail.
*.sh    text eol=lf
*.patch text eol=lf
xnu/patches/** text eol=lf
*.diff  text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.S     text eol=lf
*.ld    text eol=lf
*.mm    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.swift text eol=lf
*.ps1   text eol=lf
